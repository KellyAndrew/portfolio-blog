{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "on"
  },
  "cSpell.language": "en-US",
  "cSpell.words": [
    "AstroPaper",
    "CSAF",
    "CVSS",
    "embargogate",
    "frontmatter",
    "Lauret",
    "pubDatetime",
    "SBOM",
    "SBOMs",
    "Shostack",
    "Starlight",
    "VEX"
  ]
}
